# Set to "true" for local development, "false" for production (same-origin /api & wss://current-host)
VITE_IS_LOCAL=false

# Backend API & WebSocket URLs
# For production on same domain via reverse proxy, use /api and / (auto-resolves to wss://your-domain)
VITE_API_URL=/api
VITE_WS_URL=/

# Sports Live TV Stream
VITE_LIVE_TV_URL=https://tv.nautical7.com/stream
VITE_LIVE_TV_KEY=your_sports_tv_key_here

# Casino Live TV Stream
VITE_CASINO_TV_BASE_URL=https://scoreapi.nautical7.com
VITE_CASINO_TV_KEY=your_casino_tv_key_here

# Live Score Iframe (Real Cricket iscc=0, Football, Tennis, Horse Racing)
VITE_SCORE_IFRAME_BASE_URL=https://scoreapi.nautical7.com
VITE_SCORE_IFRAME_KEY=your_score_iframe_key_here

# Static CDN Fallback (virtual casino fallback images)
VITE_ASSET_CDN_URL=https://cdn.926assets.com/g3ver/v107/static/front/img

APP_TYPE=client
CLIENT_PORT=8100
