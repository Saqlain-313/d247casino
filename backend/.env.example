# ============================================
# DATABASE & CACHE
# ============================================
MONGO_URI=mongodb://127.0.0.1:27017/reddy777
REDIS_URL=redis://127.0.0.1:6379

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET=replace_with_strong_random_secret
JWT_EXPIRES_IN=7d

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=production
APP_TYPE=client
PORT=3000
CLIENT_PORT=8100
DASHBOARD_PORT=8101

# Comma-separated allowed CORS origins (client + dashboard domains)
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com,https://dashboard.your-domain.com

# Optional custom DNS servers (comma-separated)
DNS_SERVERS=1.1.1.1,8.8.8.8

# ============================================
# EXTERNAL API (Sports / Casino Provider)
# Provider switch: "providerA" | "providerB" | "providerC"
# ============================================
API_PROVIDER=providerA
API_URL=https://scoreapi.nautical7.com
API_KEY=your_provider_api_key
RESULT_API_URL=https://scoreapi.nautical7.com

# Non-declared fancies / matches upstream
NON_DECLARED_API_URL=https://a.81club.fun

# IP geolocation endpoint used for login history
IP_GEO_API_URL=https://ipapi.co

# ============================================
# CASINO CACHE TTLs (seconds unless noted)
# ============================================
CASINO_LIST_TTL_HOURS=6
CASINO_CACHE_TTL=5
CASINO_BETTING_TTL=1
CASINO_RESULT_TTL=5
CASINO_DIRECT_RESULT_TTL=5
CASINO_RESULT_DETAIL_TTL=5

# ============================================
# FEATURE FLAGS
# ============================================
DEV_MOCK_API=0
